FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY preview-web/package.json preview-web/package-lock.json preview-web/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY preview-web/ ./
RUN npm run build

FROM python:3.13-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg unixodbc && \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements-preview.txt .
RUN pip install --no-cache-dir -r requirements-preview.txt
COPY preview_api.py sql_connection.py category_scope.py standings_corrections.py rider_profiles.py rider_media.py rider_numbers.py circuit_catalog.py circuit_catalog.json media_catalog.json ./
COPY rider_profiles.reviewed.json ./
COPY assets/ ./assets/
COPY --from=web /web/dist ./preview-web/dist
EXPOSE 8501
HEALTHCHECK CMD curl --fail http://localhost:8501/api/health || exit 1
CMD ["uvicorn", "preview_api:app", "--host", "0.0.0.0", "--port", "8501"]
